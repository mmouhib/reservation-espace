# Copy to apps/web/.env.local. NEXT_PUBLIC_* values are embedded in the client bundle
# and the service worker: they identify the Firebase project and are not secrets.

# Firebase web config (Firebase console > Project settings > Your apps). Firebase is used for Google sign-in only.
# The "demo-" project id lets the Auth emulator run without any real Firebase project.
NEXT_PUBLIC_FIREBASE_API_KEY=demo-api-key
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=demo-reservation-espace.firebaseapp.com
NEXT_PUBLIC_FIREBASE_PROJECT_ID=demo-reservation-espace
NEXT_PUBLIC_FIREBASE_APP_ID=

# Local development against the Firebase Auth emulator.
NEXT_PUBLIC_USE_EMULATORS=true
NEXT_PUBLIC_EMULATOR_HOST=127.0.0.1

# Address of the server. Leave empty when the server also serves the web app (production).
# With `next dev` (npm run dev) the server runs on another port.
NEXT_PUBLIC_API_URL=http://localhost:8080

# Public key for push notifications (the pair of VAPID_PUBLIC_KEY in server/.env.local).
NEXT_PUBLIC_VAPID_PUBLIC_KEY=

# Password of the seeded demo accounts (emulator only; used by the seed script and the dev sign-in panel).
NEXT_PUBLIC_DEMO_PASSWORD=change-me-demo
