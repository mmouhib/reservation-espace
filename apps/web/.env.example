# Copy to apps/web/.env.local. NEXT_PUBLIC_* values are embedded in the client bundle
# and the service worker: they identify the Firebase project and are not secrets.

# Firebase web config (Firebase console → Project settings → Your apps).
# The "demo-" project id lets the emulators run without any real Firebase project.
NEXT_PUBLIC_FIREBASE_API_KEY=demo-api-key
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=demo-reservation-espace.firebaseapp.com
NEXT_PUBLIC_FIREBASE_PROJECT_ID=demo-reservation-espace
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=demo-reservation-espace.appspot.com
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=
NEXT_PUBLIC_FIREBASE_APP_ID=
# Web Push certificate (Project settings → Cloud Messaging). Needed for push in phase 3.
NEXT_PUBLIC_FIREBASE_VAPID_KEY=

# Local development against the Firebase Emulator Suite.
NEXT_PUBLIC_USE_EMULATORS=true
NEXT_PUBLIC_EMULATOR_HOST=127.0.0.1

# Sign-in provider: "google" (dev stub), "oidc.<providerId>" or "saml.<providerId>" (company SSO).
NEXT_PUBLIC_AUTH_PROVIDER=google

# Password of the seeded demo accounts (emulators only; used by the seed script and the dev sign-in panel).
NEXT_PUBLIC_DEMO_PASSWORD=change-me-demo
