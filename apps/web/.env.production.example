# Web configuration for a deployment. Copy this file to apps/web/.env.production.local (git-ignored),
# fill it in, then run `npm run build` (see "Deployment" in the README).
#
# Next.js reads .env.production.local before .env.local, so the emulator settings you keep in
# .env.local for development are not used by the build. Rename or delete .env.production.local
# again before building for development.
# These values end up in the public JavaScript: they identify the project and are not secrets.

# Firebase console > Project settings > Your apps > Web app > SDK setup and configuration.
NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=<project-id>.firebaseapp.com
NEXT_PUBLIC_FIREBASE_PROJECT_ID=<project-id>
NEXT_PUBLIC_FIREBASE_APP_ID=

# Never true in a deployment: it would send sign-in to the local emulator.
NEXT_PUBLIC_USE_EMULATORS=false

# Leave empty: the server serves the web app, so the API is on the same address.
NEXT_PUBLIC_API_URL=

# Stripe publishable key (pk_live_... for real payments, pk_test_... to simulate them). Needed to buy credits.
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=

# Optional, for push notifications: the public key of `npx web-push generate-vapid-keys`.
# The private key goes in the server's environment (VAPID_PRIVATE_KEY).
NEXT_PUBLIC_VAPID_PUBLIC_KEY=
