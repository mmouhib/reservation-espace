rules_version = '2';

// Strategy: default deny. Reads are scoped by role and ownership. Anything that
// needs trust (roles, bookings, slots, credits, audit) is written by Cloud
// Functions only; the Admin SDK bypasses these rules.
service cloud.firestore {
  match /databases/{database}/documents {

    // ---------- Helpers ----------
    function signedIn() {
      return request.auth != null;
    }

    // A "member" has been bootstrapped by the bootstrapProfile function, which
    // sets the role claim only for allowed company accounts.
    function isMember() {
      return signedIn() && request.auth.token.role in ['user', 'manager', 'admin'];
    }

    function isManager() {
      return isMember() && request.auth.token.role in ['manager', 'admin'];
    }

    function isAdmin() {
      return isMember() && request.auth.token.role == 'admin';
    }

    function isSelf(uid) {
      return isMember() && request.auth.uid == uid;
    }

    function changedKeys() {
      return request.resource.data.diff(resource.data).affectedKeys();
    }

    function isOptionalString(value, maxLen) {
      return value == null || (value is string && value.size() <= maxLen);
    }

    // ---------- Users ----------
    function validNotificationPrefs(p) {
      return p is map
        && p.keys().hasOnly(['email', 'push', 'weeklyDigest'])
        && p.keys().hasAll(['email', 'push', 'weeklyDigest'])
        && p.email is bool && p.push is bool && p.weeklyDigest is bool;
    }

    function validLocale(data) {
      return !('locale' in data) || data.locale in ['fr', 'en'];
    }

    match /users/{uid} {
      allow read: if isSelf(uid) || isAdmin();
      // Profiles are created by bootstrapProfile; role/status/claims fields are server-owned.
      allow create, delete: if false;
      allow update: if isSelf(uid)
        && changedKeys().hasOnly(['displayName', 'defaultSiteId', 'notificationPrefs', 'locale'])
        && request.resource.data.displayName is string
        && request.resource.data.displayName.size() > 0
        && request.resource.data.displayName.size() <= 80
        && isOptionalString(request.resource.data.defaultSiteId, 64)
        && validNotificationPrefs(request.resource.data.notificationPrefs)
        && validLocale(request.resource.data);

      // FCM registration tokens, one document per device.
      match /devices/{deviceId} {
        allow read, delete: if isSelf(uid);
        allow create, update: if isSelf(uid)
          && request.resource.data.keys().hasOnly(['fcmToken', 'platform', 'userAgent', 'lastSeenAt'])
          && request.resource.data.fcmToken is string
          && request.resource.data.fcmToken.size() < 4096
          && request.resource.data.platform is string
          && request.resource.data.lastSeenAt == request.time;
      }

      // In-app inbox. Written by Functions; the user can only mark items as read.
      match /notifications/{notificationId} {
        allow read: if isSelf(uid);
        allow update: if isSelf(uid)
          && changedKeys().hasOnly(['readAt'])
          && request.resource.data.readAt == request.time;
      }
    }

    // ---------- Reference data ----------
    match /departments/{departmentId} {
      allow read: if isMember();
      allow write: if isAdmin();
    }

    match /teams/{teamId} {
      allow read: if isMember();
      allow write: if isAdmin();
    }

    match /sites/{siteId} {
      allow read: if isMember();
      allow write: if isAdmin();
    }

    // ---------- Spaces ----------
    function validOpeningHours(h) {
      return h is map && h.keys().hasOnly(['mon', 'tue', 'wed', 'thu', 'fri', 'sat', 'sun']);
    }

    function validSpace(d) {
      return d.keys().hasAll(['siteId', 'floor', 'location', 'name', 'category', 'capacity', 'creditsPerHour',
                              'equipment', 'tags', 'openingHours', 'status', 'closures'])
        && d.siteId is string && d.siteId.size() > 0
        && d.name is string && d.name.size() > 0 && d.name.size() <= 80
        && d.floor is string && d.location is string && d.location.size() <= 120
        && d.category in ['desk', 'open_space', 'meeting_room', 'coworking', 'phone_booth']
        && d.capacity is int && d.capacity >= 1 && d.capacity <= 500
        && d.creditsPerHour is number && d.creditsPerHour >= 0 && d.creditsPerHour <= 1000
        && d.equipment is list && d.equipment.size() <= 10
        && d.tags is list && d.tags.size() <= 10
        && d.status in ['active', 'closed']
        && d.closures is list && d.closures.size() <= 50
        && validOpeningHours(d.openingHours);
    }

    match /spaces/{spaceId} {
      allow read: if isMember();
      allow create, update: if isAdmin() && validSpace(request.resource.data);
      allow delete: if isAdmin();
    }

    // ---------- Bookings and absences (written by Cloud Functions only) ----------
    match /bookings/{bookingId} {
      allow read: if isMember() && (resource.data.userId == request.auth.uid || isAdmin());
      allow write: if false;
    }

    match /absences/{absenceId} {
      allow read: if isMember() && (resource.data.userId == request.auth.uid || isAdmin());
      allow write: if false;
    }

    // ---------- Credits and subscriptions ----------
    match /wallets/{uid} {
      allow read: if isSelf(uid) || isAdmin();
      allow write: if false;
    }

    match /creditTransactions/{transactionId} {
      allow read: if isMember() && (resource.data.userId == request.auth.uid || isAdmin());
      allow write: if false;
    }

    match /plans/{planId} {
      allow read: if isMember();
      allow write: if isAdmin()
        && request.resource.data.name is string && request.resource.data.name.size() > 0
        && request.resource.data.kind in ['pack', 'subscription']
        && request.resource.data.credits is int && request.resource.data.credits > 0
        && request.resource.data.priceCents is int && request.resource.data.priceCents >= 0
        && request.resource.data.active is bool;
      allow delete: if isAdmin();
    }

    match /subscriptions/{subscriptionId} {
      allow read: if isMember() && (resource.data.userId == request.auth.uid || isAdmin());
      allow write: if false;
    }

    // ---------- Incidents and equipment requests ----------
    function validNewIncident(d) {
      return d.keys().hasOnly(['reporterId', 'reporterName', 'spaceId', 'spaceName', 'title', 'description',
                               'photoPaths', 'status', 'adminNote', 'createdAt', 'updatedAt'])
        && d.reporterId == request.auth.uid
        && d.title is string && d.title.size() > 0 && d.title.size() <= 120
        && d.description is string && d.description.size() <= 2000
        && d.photoPaths is list && d.photoPaths.size() <= 3
        && d.status == 'open'
        && d.adminNote == ''
        && d.createdAt == request.time && d.updatedAt == request.time;
    }

    match /incidents/{incidentId} {
      allow read: if isMember() && (resource.data.reporterId == request.auth.uid || isAdmin());
      allow create: if isMember() && validNewIncident(request.resource.data);
      allow update: if isAdmin()
        && changedKeys().hasOnly(['status', 'adminNote', 'updatedAt'])
        && request.resource.data.status in ['open', 'in_progress', 'resolved']
        && request.resource.data.adminNote is string && request.resource.data.adminNote.size() <= 1000;
      allow delete: if false;
    }

    function validNewEquipmentRequest(d) {
      return d.keys().hasOnly(['requesterId', 'requesterName', 'item', 'quantity', 'neededOn', 'comment',
                               'status', 'adminNote', 'createdAt', 'updatedAt'])
        && d.requesterId == request.auth.uid
        && d.item in ['screen', 'keyboard', 'mouse', 'headset', 'webcam', 'adapter', 'chair']
        && d.quantity is int && d.quantity >= 1 && d.quantity <= 20
        && d.neededOn is string && d.neededOn.matches('^[0-9]{4}-[0-9]{2}-[0-9]{2}$')
        && d.comment is string && d.comment.size() <= 500
        && d.status == 'pending'
        && d.adminNote == ''
        && d.createdAt == request.time && d.updatedAt == request.time;
    }

    match /equipmentRequests/{requestId} {
      allow read: if isMember() && (resource.data.requesterId == request.auth.uid || isAdmin());
      allow create: if isMember() && validNewEquipmentRequest(request.resource.data);
      allow update: if isAdmin()
        && changedKeys().hasOnly(['status', 'adminNote', 'updatedAt'])
        && request.resource.data.status in ['pending', 'approved', 'rejected']
        && request.resource.data.adminNote is string && request.resource.data.adminNote.size() <= 1000;
      allow delete: if false;
    }

    // ---------- Server-owned ----------
    match /auditLogs/{logId} {
      allow read: if isAdmin();
      allow write: if false;
    }

    // _rateLimits, config and anything not matched above: denied by default.
  }
}
