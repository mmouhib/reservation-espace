# Copy to functions/.env.local for the emulators (never committed),
# or to functions/.env.<projectId> for a deployed project.

# Comma-separated emails that receive the admin role on first sign-in.
BOOTSTRAP_ADMIN_EMAILS=admin@exemple.fr

# Comma-separated email domains allowed to sign in. Empty = any domain (dev only).
ALLOWED_EMAIL_DOMAINS=exemple.fr

# Enforce App Check on callable functions (true in production).
ENFORCE_APP_CHECK=false

# Credits given to every new account (0 to give none).
WELCOME_CREDITS=0

# Sender address for notification emails, sent through Resend.
RESEND_FROM=Réservation <no-reply@exemple.fr>
# Resend API key is a secret, like the Gemini key below: leave it empty to skip emails in dev.
#   Deployed project: firebase functions:secrets:set RESEND_API_KEY
#   Emulators: put RESEND_API_KEY=your-key in functions/.secret.local (gitignored)

# MongoDB connection string. Local dev: Docker Compose (`npm run mongo:up`), a single-node
# replica set (required for transactions) on 127.0.0.1:27017. Production: set via
# `firebase functions:secrets:set MONGODB_URI` (Atlas URI), not this file.
MONGODB_URI=mongodb://127.0.0.1:27017/reservation?replicaSet=rs0

# Gemini API key (ai.google.dev) for the AI assistant and plan-description generator.
# This is a real secret, so it is NOT read from this .env file: it lives in Secret Manager.
#   Deployed project: firebase functions:secrets:set GOOGLE_GENERATIVE_AI_API_KEY
#   Emulators: put GOOGLE_GENERATIVE_AI_API_KEY=your-key in functions/.secret.local (gitignored)
