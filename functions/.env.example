# Copy to functions/.env.local for the emulators (never committed),
# or to functions/.env.<projectId> for a deployed project.

# Comma-separated emails that receive the admin role on first sign-in.
BOOTSTRAP_ADMIN_EMAILS=admin@exemple.fr

# Comma-separated email domains allowed to sign in. Empty = any domain (dev only).
ALLOWED_EMAIL_DOMAINS=exemple.fr

# Enforce App Check on callable functions (true in production).
ENFORCE_APP_CHECK=false

# Phase 3 — SendGrid (store the API key as a secret: firebase functions:secrets:set SENDGRID_API_KEY)
MAIL_FROM=reservation@exemple.fr
