# Copy to server/.env.local for development (git-ignored). In production the same names are set as
# environment variables on the host (see "Deployment" in the README): do not upload a file with secrets.

# ---------- Sign-in (Firebase Auth: the only Firebase service used) ----------

# Firebase project that issues the Google sign-in tokens. In development with the Auth emulator,
# any "demo-" id works.
FIREBASE_PROJECT_ID=demo-reservation-espace

# Development: the Auth emulator (`npm run dev` starts it). Remove this line in production.
FIREBASE_AUTH_EMULATOR_HOST=127.0.0.1:9099

# Production only: the service account key (Firebase console > Project settings > Service accounts >
# Generate new private key), the whole JSON on one line. The server uses it to set roles and to
# disable the accounts of people who left. Alternatively set GOOGLE_APPLICATION_CREDENTIALS to the file.
# FIREBASE_SERVICE_ACCOUNT=

# ---------- Database ----------

# MongoDB connection string. Local dev: Docker Compose (`npm run mongo:up`), a one-node replica set
# (required for transactions). Production: an Atlas URI such as mongodb+srv://user:password@cluster/reservation.
MONGODB_URI=mongodb://127.0.0.1:27017/reservation?replicaSet=rs0
# Use another database than the one in the connection string (a development database in Atlas, for example).
# MONGODB_DB_NAME=reservation_dev

# ---------- Access ----------

# Comma-separated emails that receive the admin role on first sign-in.
BOOTSTRAP_ADMIN_EMAILS=admin@exemple.fr

# Comma-separated email domains allowed to sign in. Empty = any domain (dev only).
ALLOWED_EMAIL_DOMAINS=exemple.fr

# Credits given to every new account (0 to give none).
WELCOME_CREDITS=0

# ---------- Server ----------

PORT=8080

# Origins allowed to call the API from another address. Only needed for `next dev` (npm run dev).
CORS_ORIGINS=http://localhost:3000

# ---------- Optional services ----------

# Gemini API key (ai.google.dev) for the AI assistant and the plan-description generator.
# GOOGLE_GENERATIVE_AI_API_KEY=

# Notification emails through Resend (resend.com). Without a key, emails are skipped.
# RESEND_API_KEY=
RESEND_FROM=Réservation <no-reply@exemple.fr>

# Push notifications (Web Push): generate a pair with `npx web-push generate-vapid-keys`. The public key
# is also NEXT_PUBLIC_VAPID_PUBLIC_KEY in apps/web. Without them, push is skipped.
# VAPID_PUBLIC_KEY=
# VAPID_PRIVATE_KEY=
# VAPID_SUBJECT=mailto:admin@yourdomain.com
